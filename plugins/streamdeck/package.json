{
  "name": "@streamslate/streamdeck-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "First-party StreamSlate Stream Deck plugin",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/normalize-bundle.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "capture:validation": "node scripts/capture-validation.mjs",
    "preflight": "npm run typecheck && npm test && npm run build && npm run validate:package",
    "pack:local": "npm run preflight && streamdeck pack ./ai.flexinfer.streamslate.sdPlugin",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.4",
    "@types/ws": "^8.18.1",
    "rollup": "^4.44.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  }
}
