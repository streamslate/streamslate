{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "importHelpers": true,
    "experimentalDecorators": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "rollup.config.mjs"]
}
